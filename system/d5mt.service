[Unit]
Description=D5MT Robot Hand Client
Wants=network-online.target
After=network-online.target
After=dev-ttyACM0.device

[Service]
Type=simple

User=double
Group=double
SupplementaryGroups=dialout

Environment=HOME=/home/double
Environment=LANG=C.UTF-8
Environment=PYTHONUNBUFFERED=1

WorkingDirectory=/opt/double-giken/d5mt
ExecStart=/opt/double-giken/d5mt/bin/d5mt-launch

Restart=on-failure
RestartSec=3

KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
